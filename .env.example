# Copy to .env. Everything is optional: with nothing set, it runs offline in memory.

# Brain: rule (deterministic, default) or llm (any OpenAI-compatible endpoint)
OPS_BRAIN=rule
# OPS_LLM_BASE_URL=https://api.openai.com/v1
# OPS_LLM_MODEL=gpt-4o-mini
# OPS_LLM_API_KEY=
# For Azure OpenAI use the deployment URL as the base URL and set:
# OPS_AZURE_API_VERSION=2024-10-21

# Record a model's decisions once, then replay them in CI without a key
# OPS_RECORD_CASSETTE=cassettes/llm-run.jsonl
# OPS_REPLAY_CASSETTE=cassettes/llm-run.jsonl

# Where runs live: memory | sqlite | postgres
OPS_STORE=memory
# OPS_SQLITE_PATH=opsagents.db
# OPS_DATABASE_URL=postgresql://ops:secret@localhost:5432/opsagents

# Policy and data (defaults are the bundled files)
# OPS_POLICY=policies/ops-policy.yaml
# OPS_SEED=data/ops_seed.json

# API: shared secret the gateway sends as "Authorization: Bearer ..."; group names
# OPS_SERVICE_TOKEN=
OPS_APPROVER_GROUP=ops-approvers
OPS_STAFF_GROUP=ops-staff
OPS_LOG_LEVEL=INFO
